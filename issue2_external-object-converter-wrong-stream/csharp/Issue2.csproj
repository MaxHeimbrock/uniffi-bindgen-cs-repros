<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>Repro</RootNamespace>
    <!-- Generated/*.cs (written by ../build.sh, unmodified uniffi-bindgen-cs output) is picked up by the default source glob. -->
  </PropertyGroup>

  <ItemGroup>
    <!-- Put the native library next to the executable so `dotnet run` can load it once the bindings compile. -->
    <None Include="native/libcrate_b.dylib" Link="libcrate_b.dylib" CopyToOutputDirectory="PreserveNewest" Condition="Exists('native/libcrate_b.dylib')" />
  </ItemGroup>

</Project>
